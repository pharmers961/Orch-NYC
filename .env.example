# Used by the scraper (scripts/ingest.ts), set as GitHub Actions repository
# secrets — NOT needed by the static web app.

# GEMINI_API_KEY: enables AI extraction for venue pages without structured data.
GEMINI_API_KEY=""

# TICKETMASTER_KEY: free Discovery API consumer key — pulls Family-classified
# events within 15 miles of Walnut Creek.
TICKETMASTER_KEY=""

# SERPAPI_KEY (optional): Google Events results for "kids and family events
# near Walnut Creek CA". Free tier is ~100 searches/month.
SERPAPI_KEY=""

# VITE_EVENTS_URL (optional, build-time): override where the app reads the
# events feed. Defaults to the data branch raw URL.
# VITE_EVENTS_URL="https://raw.githubusercontent.com/pharmers961/Orch-NYC/data/events.json"
